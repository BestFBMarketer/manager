# =====================================
# shorts-factory ortam degiskenleri
# Kopyala: cp .env.example .env
# =====================================

# --- LLM saglayicilari (ucretsiz katman once denenir) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Claude modeli ve efor seviyesi (maliyet kontrolu)
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low

# --- YouTube (kanal basina refresh token) ---
# Kurulum: Google Cloud Console'da "Desktop app" tipi OAuth istemcisi olustur,
# YouTube Data API v3'u etkinlestir, CLIENT_ID/SECRET'i buraya gir, sonra
# KENDI BILGISAYARINDA (VPS'te degil, tarayici gerekir) calistir:
#   npx tsx scripts/authYoutube.ts shorts
#   npx tsx scripts/authYoutube.ts travel
# Cikan refresh token'i asagidaki ilgili degiskene yapistir.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN_SHORTS=
YOUTUBE_REFRESH_TOKEN_TRAVEL=
# Referans kanal kataloglarini okumak icin (OAuth degil, public API key yeterli) -
# Google Cloud Console'da ayni projede "API key" olusturup YouTube Data API v3'e izin ver.
YOUTUBE_API_KEY=

# --- Google (Drive ingest + Places/Routes otel verisi) ---
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PLACES_API_KEY=

# --- Otel verisi elle giris (Google Places + HolidayCheck + Booking zinciri doldurmadiginda) ---
# Format: {"otel adi|sehir": {"roomCount": 42, "capacity": 4, ...}} - anahtarlar kucuk harf.
HOTEL_MANUAL_SHEET_PATH=data/hotelManual.json

# --- Kesif kaynaklari ---
PEXELS_API_KEY=
REDDIT_USER_AGENT=shorts-factory/0.1

# --- Bildirim (e-posta - hata/basari/uyari) ---
# Kurulum: kendi e-posta saglayicinin SMTP bilgileri (Gmail icin uygulama sifresi gerekir).
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_EMAIL_TO=

# --- Seslendirme (voiceover) ---
# Voicebox yerel REST API adresi (kurulu degilse Piper'a duser)
VOICEBOX_URL=http://127.0.0.1:5050
# Karakter sesi: Voicebox'ta ses adi, Piper'da .onnx model yolu
TTS_VOICE_REF=
PIPER_BIN=piper

# --- Ilgi noktalari (POI) ---
# OpenStreetMap Overpass - anahtar gerektirmez, kendi sunucun varsa degistir
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Muzik kutuphanesi (Suno vb.) ---
# Soundtrack'lerin bulundugu Drive klasoru ve yerel onbellek
MUSIC_DRIVE_FOLDER_ID=
MUSIC_LIBRARY_DIR=data/music

# --- Harita (bos birakilirsa token gerektirmeyen OpenFreeMap kullanilir) ---
MAPTILER_API_KEY=

# --- Capraz yayin (Instagram Reels + TikTok) ---
# Instagram: Meta for Developers'ta bir uygulama + Instagram Business hesabi
# gerekir (App Review sureci var). Panelden kanal baglantisinda bu degiskenin
# ADINI girersin (degerini degil) - gercek token burada, degisken adi DB'de tutulur.
# orn. INSTAGRAM_ACCESS_TOKEN_SHORTS=<uzun-omurlu-token>
#
# TikTok: TikTok for Developers'ta Content Posting API basvurusu gerekir.
# orn. TIKTOK_ACCESS_TOKEN_TRAVEL=<access-token>
#
# Instagram'in Content Publishing API'si video dosyasini degil bir "video_url"
# ister - Meta'nin sunuculari bu URL'i kendisi indirir. Onaylanan dosya bu yuzden
# kisa sureligine data/public/ altina kopyalanir ve PANEL_PORT uzerinden
# /public-media/<rastgele-id> olarak (kimlik dogrulamasiz) sunulur. Bu adresin
# internetten erisilebilir olmasi icin VPS kurulumunda nginx/Caddy bu path'i
# disariya acmali ve PUBLIC_MEDIA_BASE_URL o herkese acik adresi tutmali.
# TikTok bu adimi gerektirmez (dogrudan dosya yukler).
PUBLIC_MEDIA_BASE_URL=

# --- Yedekleme (scripts/backupDb.ts) ---
SHORTS_DB_BACKUP_DIR=data/backups
SHORTS_DB_BACKUP_RETENTION_DAYS=14

# --- Admin panel (Express + Vite/React) ---
# Kurulum: npm run panel:hash-password -- '<sifre>' ile hash uret, buraya yapistir.
PANEL_PASSWORD_HASH=
# Oturum cerezini imzalamak icin rastgele, uzun bir metin (orn. `openssl rand -hex 32`)
PANEL_SESSION_SECRET=
PANEL_PORT=4000

# --- Performans (opsiyonel - genelde bos birak) ---
# NVIDIA GPU'lu bir is istasyonunda hizli render icin: VIDEO_HW_ENCODER=h264_nvenc
# (VPS'te GPU yoksa bos kalmali, CPU/libx264'e duser).
VIDEO_HW_ENCODER=
# Remotion render paralelligi. Bos birakilirsa Remotion kendi mantikli
# varsayimini kullanir (min(8, cekirdek/2)). Dusuk RAM'li VPS'te acikca
# dusurulebilir (her paralel is kendi headless Chrome'unu acar).
REMOTION_CONCURRENCY=
